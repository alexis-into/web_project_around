{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./public",
    "allowJs": true,

    "module": "es6",
    "target": "es2022",
    "types": [],

    "sourceMap": true,

    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}
